APP_NAME="Colegio Virtual (piloto)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_TIMEZONE=America/La_Paz
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Piloto: SQLite en un archivo (database/database.sqlite por defecto).
# Sin servidor de base de datos ni Docker. PostgreSQL solo en una implementación real.
DB_CONNECTION=sqlite
# DB_DATABASE=/ruta/absoluta/a/database.sqlite

SESSION_DRIVER=database
# La inactividad de la sesión (HU-002) se fija con COLEGIO_SESION_INACTIVIDAD_MINUTOS
# (config/colegio.php); SESSION_LIFETIME ya no se usa.
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Colas en la base de datos: el worker se levanta con `composer dev`
# (o `php artisan queue:work`). Las notificaciones por correo van en cola.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Redis no se usa en el piloto (mejora futura).
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Correo: ningún correo sale a personas reales.
# Por defecto los correos quedan escritos en storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-responder@colegio-piloto.test"
MAIL_FROM_NAME="${APP_NAME}"

# Opcional para la demostración: Mailpit (https://mailpit.axllent.org) muestra
# los correos en http://127.0.0.1:8025. Descomente estas líneas y comente
# MAIL_MAILER=log de arriba.
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=1025
# MAIL_USERNAME=null
# MAIL_PASSWORD=null

VITE_APP_NAME="${APP_NAME}"

# Colegio Virtual (config/colegio.php) — piloto con datos ficticios
COLEGIO_DOMINIO_INSTITUCIONAL=colegio-piloto.test
COLEGIO_SESION_INACTIVIDAD_MINUTOS=30
COLEGIO_BLOQUEO_INTENTOS=5
COLEGIO_BLOQUEO_VENTANA_MINUTOS=15
COLEGIO_BLOQUEO_MINUTOS=15
COLEGIO_CONTRASENA_TEMPORAL_HORAS=72
COLEGIO_INVITACION_HORAS=72
COLEGIO_RESTABLECIMIENTO_MINUTOS=30
